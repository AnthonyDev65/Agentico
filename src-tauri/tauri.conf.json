{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentico-ide",
  "version": "0.1.0",
  "identifier": "com.casti.agentico-ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentico IDE",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
